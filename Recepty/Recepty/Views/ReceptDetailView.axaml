<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recepty.ViewModels"
             xmlns:models="using:Recepty.Models"
             x:Class="Recepty.Views.ReceptDetailView"
             x:DataType="vm:ReceptDetailViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12">

            <Button Command="{Binding BackCommand}" Content="← Zpět na seznam"
                    HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding ReceptNazev}" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="{Binding ReceptKategorie}" Opacity="0.6"/>
            <TextBlock Text="{Binding ReceptPostup}" TextWrapping="Wrap"/>

            <TextBlock Text="Ingredience" FontSize="20" FontWeight="Bold" Margin="0,12,0,0"/>

            <ListBox ItemsSource="{Binding Ingredience}"
                     SelectedItem="{Binding SelectedIngredience}"
                     MaxHeight="220">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Ingredience">
                        <TextBlock>
                            <Run Text="{Binding Nazev}"/>
                            <Run Text="{Binding Mnozstvi}"/>
                            <Run Text="{Binding Jednotka}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Přidat / upravit ingredienci" FontWeight="Bold"/>

                    <TextBox Watermark="Název *" Text="{Binding IngredNazev}"/>
                    <TextBox Watermark="Množství" Text="{Binding IngredMnozstvi}"/>
                    <TextBox Watermark="Jednotka" Text="{Binding IngredJednotka}"/>

                    <TextBlock Text="{Binding Chyba}" Foreground="Red"
                               IsVisible="{Binding Chyba, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding AddIngredienceCommand}" Content="Přidat"/>
                        <Button Command="{Binding UpdateIngredienceCommand}" Content="Uložit změnu"/>
                        <Button Command="{Binding DeleteIngredienceCommand}" Content="Smazat"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>